clude_bot_messages":{"type":"bool","default":true},"bot_identifiers":{"type":"string","default":"bot"}}},"schedule_settings":{"type":"object","items":{"min_interval_minutes":{"type":"int","default":30},"max_interval_minutes":{"type":"int","default":600},"quiet_hours":{"type":"string","default":"1-7"},"max_unanswered_times":{"type":"int","default":4}}},"tts_settings":{"type":"object","items":{"enable_tts":{"type":"bool","default":true},"always_send_text":{"type":"bool","default":true}}},"segmented_reply_settings":{"type":"object","items":{"enable":{"type":"bool","default":false},"words_count_threshold":{"type":"int","default":80},"split_mode":{"type":"string","default":"regex"},"regex":{"type":"string","default":".*?[。？！~…\\n]+|.+$"},"split_words":{"type":"list","default":["。","？","！","~","…"]},"enable_content_cleanup":{"type":"bool","default":false},"content_cleanup_rule":{"type":"string","default":"[\\n]"},"interval_method":{"type":"string","default":"log"},"interval":{"type":"string","default":"1.5, 3.5"},"log_base":{"type":"string","default":"1.8"}}}}},"group_settings":{"type":"object","items":{"enable":{"type":"bool","default":false},"session_list":{"type":"list","default":[]},"auto_trigger_settings":{"type":"object","items":{"enable_auto_trigger":{"type":"bool","default":false},"auto_trigger_after_minutes":{"type":"int","default":5}}},"group_idle_trigger_minutes":{"type":"int","default":30},"proactive_prompt":{"type":"text","default":"[系统任务：群聊主动破冰]\n你被授权在群聊中发起一次“主动消息”以活跃气氛。你的回复必须完全符合你的人格设定，并严格遵守所有的输出规则。\n\n[情景分析]\n- 这个群聊好像已经冷清了一段时间了，我应该说些什么来让大家重新聊起来。\n- 当前时间是: {{current_time}}。\n- 我上次在这个群里主动说话但没人理我的次数是: {{unanswered_count}} 次。\n\n[行动指南]\n1.  回顾群聊的聊天记录，看看大家最后在讨论什么有趣的话题，如果没有聊完，尝试延续它。\n2.  向群里的所有人，提出一个开放性的、大家都能参与进来的问题。\n\n[最终指令]\n请综合以上所有信息，用最像你自己的、最自然的方式，生成一句能在群聊中打破僵局、活跃气氛的开场白。"},"context_settings":{"type":"object","items":{"source_mode":{"type":"string","default":"platform_message_history"},"platform_history_count":{"type":"int","default":20},"platform_history_pr