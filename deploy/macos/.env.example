# Copy to .env; chmod 600 .env. Plain KEY=value or quoted literal; no shell expansion.
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
# Your human QQ account, not the bot. Supply locally; never commit it.
OWNER_QQ=
# Optional bot account, for fast login after its first local QR login.
BOT_QQ=
# After /sid, put the exact private-chat UMO here. Initially empty: no proactive sends.
OWNER_UMO=
# Generate two different random values, e.g. openssl rand -hex 24
ONEBOT_TOKEN=
NAPCAT_WEBUI_TOKEN=
# At least 12 characters, including uppercase, lowercase and a digit.
ASTRBOT_PASSWORD=
ASTRBOT_PORT=16185
NAPCAT_PORT=16099
ASTRBOT_MEMORY=1536m
NAPCAT_MEMORY=1280m
ASTRBOT_CPUS=1.0
NAPCAT_CPUS=1.0
DAFEIYU_IMAGE=dafeiyu-macos:20261108
# These settings seed NEW configs only. Later change them in the AstrBot UI.
QUIET_HOURS=23-8
PROACTIVE_MIN_MINUTES=120
PROACTIVE_MAX_MINUTES=240
PROACTIVE_MAX_UNANSWERED=2
# Destructive automatic memory cleanup is OFF initially.
MEMORY_AUTO_CLEANUP=false
MEMORY_CLEANUP_DAYS=90
MEMORY_CLEANUP_IMPORTANCE=0.3
